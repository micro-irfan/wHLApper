manifest {
    name            = 'wHLApper'
    description     = 'Nextflow wrapper for HLA*LA HLA typing of ONT BAMs'
    mainScript      = 'main.nf'
    version         = '1.0.0'
    nextflowVersion = '>=22.10.0'
}

params {
    // Input
    input        = null      // .bam/.cram or samplesheet .csv/.tsv
    sample_id    = null      // single-BAM mode only
    reference    = null      // FASTA used for alignment (.fai alongside)
    graph_dir    = null      // HLA*LA graph folder, e.g. PRG_MHC_GRCh38_withIMGT
    hla_reference     = null // HLA decoy FASTA to realign to, e.g. GRCh38_full_analysis_set_plus_decoy_hla.fa
    hla_reference_mmi = null // optional prebuilt minimap2 index of hla_reference
    outdir       = 'results'

    // QC thresholds (strictly greater than)
    min_coverage = 20
    min_q1       = 0.95

    // Behaviour
    skip_extract = false
    help         = false

    // Resources
    threads      = 8
    hla_memory   = '64 GB'
    align_memory = '32 GB'

    // Software
    hla_container     = '682905754632.dkr.ecr.ap-southeast-1.amazonaws.com/nala/hla-la:v1.0.3'
    python_container  = 'python:3.11'
    hla_conda         = null   // path to an existing env, otherwise envs/hlala.yml
    python_conda      = null   // path to an existing env, otherwise envs/python.yml
    singularity_cache = null
    conda_cache       = null

    // Slurm profile
    queue        = null
}

process {
    withLabel: hlala {
        container = params.hla_container
        conda     = params.hla_conda ?: "${projectDir}/envs/hlala.yml"
        cpus      = 4
        memory    = '8 GB'
    }
    withLabel: python {
        container = params.python_container
        conda     = params.python_conda ?: "${projectDir}/envs/python.yml"
        cpus      = 1
        memory    = '2 GB'
    }
    withName: MINIMAP2_ALIGN {
        cpus   = params.threads
        memory = params.align_memory
    }
    withName: HLALA {
        cpus   = params.threads
        memory = params.hla_memory
    }
}

profiles {
    docker {
        docker.enabled         = true
        docker.fixOwnership    = true
        singularity.enabled    = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = params.singularity_cache
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        conda.enabled          = true
        conda.cacheDir         = params.conda_cache
        docker.enabled         = false
        singularity.enabled    = false
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = params.queue
    }
}

trace.overwrite    = true
timeline.overwrite = true
report.overwrite   = true
dag.overwrite      = true

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
