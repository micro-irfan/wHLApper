manifest {
    name = 'TAS-LRS ONT PGx Workflow'
    author = 'Nalagenetics'
    homepage = 'https://bitbucket.org/nalagenetics/pgx-longread/src/main/'
    description = 'In-house Pipeline for PGx ONT Sequencing'
    mainScript = 'main.nf'
    version = '1.0.0'
}

params {
    infodir = "${params.outdir}/info"
    longreadpyver = "1.0.3"
    // s3_LongRead_references = "s3://nala-ont-data/ref/1.0.0"
    s3_LongRead_references = "/home/nalagenetics/ref/1.0.0"
    tag_separator = "_"
    test = "True"

    // Common
    bam = null
    vcf = null
    skip_qc = null
    skip_hla = null
    skip_impute = null
    ont = null
    vc = null
    support = null

    // ubamDir
    ubamDir = "/media/ontdata/to_analyze/"
}

// for testing 
trace.overwrite = true
timeline.overwrite = true
dag.overwrite = true
report.overwrite = true

trace {
    enabled = true
    file = "${params.infodir}/trace.txt"
}

timeline {
    enabled = true
    file = "${params.infodir}/timeline.html"
}

dag {
    enabled = true
    file = "${params.infodir}/dag.html"
}

report {
    enabled = true
    file = "${params.infodir}/report.html"
}

// variables
// supply ecr_repo in cli: --ecr_repo 682905754632.dkr.ecr.ap-southeast-1.amazonaws.com
ecr_repo = params.ecr_repo

// s3
plugins {
	id "nf-amazon"
}

// docker
docker.enabled = true
docker.fixOwnership = true

process {
    withName:ALIGNMENTONT {
        container = "${ecr_repo}/nala/minimap2:2.22-r1101"
        cpus = 32
        memory = '64 GB'
    }
    
    withName:SAMTOBAM {
        container = "${ecr_repo}/nala/samtools:awsomics"
        cpus = 8
        memory = '16 GB'
    }

    withName:FIXPLOIDY {
        container = "${ecr_repo}/nala/vcftools-fix-ploidy:awsomics"
        cpus = 1
    }

    withName:PHARMCAT {
        container = "${ecr_repo}/nala/pharmcat:v2.2.3-ubuntu"
        cpus = 1
    }

    withName:MERGEFILESONT {
        container = "${ecr_repo}/nala/quay.io/biocontainers/bcftools:1.16"
        cpus = 1
    }

    withName:GVCF2VCF {
        container = "${ecr_repo}/nala/quay.io/biocontainers/bcftools:1.16"
        cpus = 1
    }

    withName:GENERATEWT {
        container = "${ecr_repo}/nala/quay.io/biocontainers/bcftools:1.16"
        cpus = 1
    }

    withName:EXTRACTCOREVARIANTS {
        container = "${ecr_repo}/nala/quay.io/biocontainers/bcftools:1.16"
        cpus = 1
    }

    withName:KEEPGT {
        container = "${ecr_repo}/nala/quay.io/biocontainers/bcftools:1.16"
        cpus = 1
    }

    withName:INDEX_BGZIP_VCF {
        container = "${ecr_repo}/nala/quay.io/biocontainers/bcftools:1.16"
        cpus = 1
    }

    withName:PHARMCATTOTSV {
        container = "${ecr_repo}/nala/longreadpy:${params.longreadpyver}"
        cpus = 1
    }

    withName:PYPGX {
        container = "${ecr_repo}/nala/longreadpy:${params.longreadpyver}"
        cpus = 1
    }

    withName:SUMMARIZE_DIPLOTYPE {
        container = "${ecr_repo}/nala/longreadpy:${params.longreadpyver}"
        cpus = 1
    }

}